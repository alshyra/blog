---
// WorkflowScrolly.astro — Chat sticky + scrollytelling
// Le chat reste fixe, les messages ET les annotations apparaissent au scroll
---

<section class="scrolly">
  <!-- Le chat sticky -->
  <div class="scrolly__sticky">
    <div class="chat-window">
      <div class="chat-window__header">
        <div class="chat-window__dot"></div>
        <div class="chat-window__title">Hermes Agent</div>
        <div class="chat-window__status">
          <span class="chat-window__status-dot"></span>
          en ligne
        </div>
      </div>
      <div class="chat-window__messages" id="chat-messages"></div>
    </div>
  </div>

  <!-- Les steps (déclencheurs invisibles) -->
  <div class="scrolly__steps">
    <div class="scrolly__step" data-step="1"></div>
    <div class="scrolly__step" data-step="2"></div>
    <div class="scrolly__step" data-step="3"></div>
    <div class="scrolly__step" data-step="4"></div>
    <div class="scrolly__step" data-step="5"></div>
    <div class="scrolly__step" data-step="6"></div>
    <div class="scrolly__step" data-step="7"></div>
    <div class="scrolly__step" data-step="8"></div>
  </div>
</section>

<style is:global>
  .scrolly {
    position: relative;
    max-width: 600px;
    margin: var(--space-8) auto;
  }

  /* ---- Le chat sticky ---- */
  .scrolly__sticky {
    position: sticky;
    top: var(--space-8);
    z-index: 10;
  }

  .chat-window {
    background: var(--bg-secondary);
    border: 1px solid var(--separator);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    max-height: 440px;
    display: flex;
    flex-direction: column;
  }

  .chat-window__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--fill-quaternary);
    border-bottom: 1px solid var(--separator);
    font-size: var(--text-subheadline);
    font-weight: var(--weight-semibold);
    color: var(--label-primary);
    flex-shrink: 0;
  }

  .chat-window__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .chat-window__title { flex: 1; }

  .chat-window__status {
    font-size: var(--text-footnote);
    font-weight: var(--weight-regular);
    color: var(--label-tertiary);
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .chat-window__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-success);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  .chat-window__messages {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    scroll-behavior: smooth;
  }

  .chat-window__messages::-webkit-scrollbar { width: 4px; }
  .chat-window__messages::-webkit-scrollbar-thumb {
    background: var(--separator);
    border-radius: var(--radius-full);
  }

  /* ---- Messages ---- */
  .chat-msg {
    display: flex;
    gap: var(--space-3);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }
  .chat-msg.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .chat-msg__avatar {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    flex-shrink: 0;
  }
  .chat-msg--user .chat-msg__avatar { background: var(--fill-secondary); }
  .chat-msg--bot .chat-msg__avatar { background: var(--fill-primary); }

  .chat-msg__body { flex: 1; min-width: 0; }

  .chat-msg__name {
    font-size: var(--text-caption-1);
    font-weight: var(--weight-semibold);
    color: var(--label-primary);
    margin-bottom: 2px;
  }
  .chat-msg__name span {
    font-weight: var(--weight-regular);
    color: var(--label-tertiary);
    font-size: var(--text-caption-2);
    margin-left: var(--space-1);
  }

  .chat-msg__text {
    font-size: var(--text-callout);
    line-height: var(--leading-relaxed);
    color: var(--label-secondary);
    background: var(--fill-quaternary);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border-top-left-radius: var(--radius-xs);
  }
  .chat-msg--user .chat-msg__text {
    background: var(--fill-secondary);
    border-top-left-radius: var(--radius-md);
    border-top-right-radius: var(--radius-xs);
  }

  .chat-msg__text code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--fill-quaternary);
    padding: 0.1em 0.3em;
    border-radius: var(--radius-xs);
  }
  .chat-msg__text strong { color: var(--label-primary); }

  .chat-msg__text .text-muted {
    opacity: 0.6;
    font-size: var(--text-subheadline);
  }

  /* ---- Annotation inline ---- */
  .chat-annotation {
    font-size: var(--text-caption-1);
    color: var(--color-accent);
    padding: var(--space-1) 0 var(--space-1) calc(1.75rem + var(--space-3));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
    line-height: var(--leading-relaxed);
  }
  .chat-annotation.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .chat-annotation code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--fill-quaternary);
    padding: 0.1em 0.3em;
    border-radius: var(--radius-xs);
  }

  /* ---- Typing indicator ---- */
  .typing-dots {
    display: inline-flex;
    gap: 4px;
    padding: var(--space-2) 0;
  }
  .typing-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--label-tertiary);
    animation: dotBounce 1.2s ease-in-out infinite;
  }
  .typing-dots span:nth-child(2) { animation-delay: 0.15s; }
  .typing-dots span:nth-child(3) { animation-delay: 0.3s; }

  @keyframes dotBounce {
    0%, 60%, 100% { transform: translateY(0); }
    30% { transform: translateY(-5px); }
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* ---- Steps invisibles (déclencheurs) ---- */
  .scrolly__steps { position: relative; z-index: 1; }
  .scrolly__step { min-height: 50vh; }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .scrolly { margin: var(--space-4) auto; }
    .scrolly__sticky { top: var(--space-4); }
    .chat-window { max-height: 350px; border-radius: var(--radius-md); }
    .scrolly__step { min-height: 40vh; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-msg, .chat-annotation {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .typing-dots span { animation: none; }
  }
</style>

<script>
(function() {
  // Séquence complète : messages + annotations
  const sequence = [
    // Step 1 : Issue créée (annotation seule)
    { type: 'annotation', text: '🔵 Issue ouverte — le webhook contacte Hermes via <code>/webhooks/rpg-issues</code>' },

    // Step 2 : "hermes plan"
    { type: 'user', name: 'alshyra', text: 'hermes plan' },
    { type: 'annotation', text: '→ Hermes identifie la commande, lit l\'issue via <code>gh issue view</code>' },

    // Step 3 : Bot répond
    { type: 'bot', name: 'alshyra-bot',
      text: '<strong>Plan d\'implémentation :</strong><br><br>1. Corriger le media query dans <code>src/styles/login.css</code><br>2. Ajouter <code>env(safe-area-inset-bottom)</code><br>3. Tester sur 375px et 768px<br>4. Ouvrir une PR',
      tag: '<!-- hermes -->' },

    // Step 4 : Approve
    { type: 'user', name: 'alshyra', text: 'Hermes approve' },
    { type: 'annotation', text: '→ Hermes crée la branche <code>feat/issue-42</code>, code, commit, push' },

    // Step 5 : PR
    { type: 'bot', name: 'alshyra-bot',
      text: '✅ Branch <code>feat/issue-42</code> créée<br>✅ Correction du media query<br>✅ PR <strong>#43</strong> ouverte — <em>"Closes #42"</em><br><br><span class="text-muted">🚀 Merge → GitHub Actions → docker compose up -d</span>',
      tag: '<!-- hermes -->' },
  ];

  const chatMessages = document.getElementById('chat-messages');
  if (!chatMessages) return;

  let currentIndex = 0;

  function addMessage(msg) {
    const div = document.createElement('div');
    div.className = `chat-msg chat-msg--${msg.type}`;
    div.innerHTML = `
      <div class="chat-msg__avatar">${msg.type === 'user' ? '👤' : '🤖'}</div>
      <div class="chat-msg__body">
        <div class="chat-msg__name">${msg.name} <span>à l'instant</span></div>
        <div class="chat-msg__text">${msg.text}</div>
        ${msg.tag ? `<div class="chat-msg__tag" style="font-size:var(--text-caption-2);color:var(--label-tertiary);font-style:italic;margin-top:var(--space-2)">${msg.tag}</div>` : ''}
      </div>
    `;
    chatMessages.appendChild(div);
    requestAnimationFrame(() => requestAnimationFrame(() => div.classList.add('visible')));
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function addAnnotation(text) {
    const div = document.createElement('div');
    div.className = 'chat-annotation';
    div.innerHTML = text;
    chatMessages.appendChild(div);
    requestAnimationFrame(() => requestAnimationFrame(() => div.classList.add('visible')));
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function addTypingIndicator() {
    const div = document.createElement('div');
    div.className = 'chat-msg chat-msg--bot';
    div.id = 'typing-indicator';
    div.innerHTML = `
      <div class="chat-msg__avatar">🤖</div>
      <div class="chat-msg__body">
        <div class="chat-msg__name">alshyra-bot <span>en train d'écrire...</span></div>
        <div class="chat-msg__text"><div class="typing-dots"><span></span><span></span><span></span></div></div>
      </div>
    `;
    chatMessages.appendChild(div);
    div.classList.add('visible');
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function removeTypingIndicator() {
    const el = document.getElementById('typing-indicator');
    if (el) el.remove();
  }

  function advanceSequence() {
    if (currentIndex >= sequence.length) return;

    const item = sequence[currentIndex];
    currentIndex++;

    if (item.type === 'annotation') {
      addAnnotation(item.text);
    } else if (item.type === 'bot') {
      addTypingIndicator();
      setTimeout(() => {
        removeTypingIndicator();
        addMessage(item);
      }, 800);
    } else {
      addMessage(item);
    }
  }

  // IntersectionObserver — chaque step déclenche un élément de la séquence
  const steps = document.querySelectorAll('.scrolly__step');
  let activeSteps = new Set();

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const stepNum = parseInt(entry.target.dataset.step);
      if (entry.isIntersecting && !activeSteps.has(stepNum)) {
        activeSteps.add(stepNum);
        advanceSequence();
      }
    });
  }, { threshold: 0.5 });

  steps.forEach(step => observer.observe(step));
})();
</script>
