---
// ui/Terminal.astro — Fenêtre terminal réutilisable
// Props: title (string)
const { title = 'terminal' } = Astro.props;
---

<div class="terminal">
  <div class="terminal__header">
    <div class="terminal__dots">
      <span class="dot dot--red"></span>
      <span class="dot dot--yellow"></span>
      <span class="dot dot--green"></span>
    </div>
    <span class="terminal__title">{title}</span>
  </div>
  <div class="terminal__body">
    <slot />
  </div>
</div>

<style is:global>
  .terminal {
    background: #0d1117;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin: var(--space-6) 0;
    box-shadow: var(--shadow-lg);
    font-family: var(--font-mono);
    font-size: var(--text-footnote);
    line-height: 1.7;
  }

  .terminal__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: #161b22;
    border-bottom: 1px solid #30363d;
  }

  .terminal__dots {
    display: flex;
    gap: 6px;
  }

  .terminal .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .terminal .dot--red { background: #ff5f57; }
  .terminal .dot--yellow { background: #febc2e; }
  .terminal .dot--green { background: #28c840; }

  .terminal__title {
    color: #8b949e;
    font-size: var(--text-caption-2);
    flex: 1;
    text-align: center;
  }

  .terminal__body {
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
  }

  .terminal .line {
    margin-bottom: var(--space-1);
  }

  .terminal .prompt {
    color: #7ee787;
    user-select: none;
  }

  .terminal .cmd {
    color: #f0f6fc;
  }

  .terminal .output {
    color: #8b949e;
  }

  .terminal .comment {
    color: #484f58;
    font-style: italic;
  }

  .terminal .success {
    color: #7ee787;
  }

  .terminal .warning {
    color: #d29922;
  }
</style>
