---
// WorkflowChat.astro — Parcours visuel du workflow Hermes
// Utilise uniquement les tokens du thème Tone pour l'intégration visuelle
---

<div class="workflow-chat">
  <!-- Frame 1 : Issue créée -->
  <div class="frame" data-frame="1">
    <div class="frame-label">01 — L'issue est créée</div>
    <div class="gh-card">
      <div class="gh-card-header">
        <span class="gh-icon">🔵</span>
        <span class="gh-title">Le bouton de login ne fonctionne plus sur mobile</span>
        <span class="gh-badge">opened</span>
      </div>
      <div class="gh-card-body">
        <p>Sur iOS Safari et Chrome Android, le bouton de login est coupé en bas de l'écran. Le media query ne prend pas en compte les <code>safe-area-inset-bottom</code>.</p>
      </div>
    </div>
    <div class="step-annotation">
      <span class="step-arrow">→</span>
      <span>Le webhook GitHub envoie une notification à Hermes via <code>/webhooks/rpg-issues</code></span>
    </div>
  </div>

  <!-- Frame 2 : User tape "hermes plan" -->
  <div class="frame" data-frame="2">
    <div class="frame-label">02 — Tu lances le plan</div>
    <div class="comment-thread">
      <div class="comment comment--user">
        <div class="comment__avatar">👤</div>
        <div class="comment__body">
          <div class="comment__meta">alshyra <span class="comment__time">il y a 2 min</span></div>
          <div class="comment__text">hermes plan</div>
        </div>
      </div>
    </div>
    <div class="step-annotation">
      <span class="step-arrow">→</span>
      <span>Hermes reçoit le commentaire, identifie la commande <code>hermes plan</code>, et lance l'analyse</span>
    </div>
  </div>

  <!-- Frame 3 : Bot répond avec un plan -->
  <div class="frame" data-frame="3">
    <div class="frame-label">03 — Hermes analyse et propose</div>
    <div class="comment-thread">
      <div class="comment comment--bot">
        <div class="comment__avatar">🤖</div>
        <div class="comment__body">
          <div class="comment__meta">alshyra-bot <span class="comment__time">il y a 1 min</span></div>
          <div class="comment__text">
            <strong>Plan d'implémentation :</strong><br><br>
            1. Corriger le media query dans <code>src/styles/login.css</code><br>
            2. Ajouter <code>env(safe-area-inset-bottom)</code><br>
            3. Tester sur 375px et 768px<br>
            4. Ouvrir une PR
            <div class="comment__tag">&lt;!-- hermes --&gt;</div>
          </div>
        </div>
      </div>
    </div>
    <div class="step-annotation">
      <span class="step-arrow">→</span>
      <span>Hermes a lu l'issue via <code>gh issue view</code>, analysé le code, et posté un plan structuré</span>
    </div>
  </div>

  <!-- Frame 4 : User approuve -->
  <div class="frame" data-frame="4">
    <div class="frame-label">04 — Tu valides</div>
    <div class="comment-thread">
      <div class="comment comment--user">
        <div class="comment__avatar">👤</div>
        <div class="comment__body">
          <div class="comment__meta">alshyra <span class="comment__time">à l'instant</span></div>
          <div class="comment__text">Hermes approve</div>
        </div>
      </div>
    </div>
    <div class="step-annotation">
      <span class="step-arrow">→</span>
      <span>Hermes crée la branche <code>feat/issue-42</code>, code la correction, commit et push</span>
    </div>
  </div>

  <!-- Frame 5 : PR créée -->
  <div class="frame" data-frame="5">
    <div class="frame-label">05 — PR ouverte, déploiement</div>
    <div class="comment-thread">
      <div class="comment comment--bot">
        <div class="comment__avatar">🤖</div>
        <div class="comment__body">
          <div class="comment__meta">alshyra-bot <span class="comment__time">à l'instant</span></div>
          <div class="comment__text">
            ✅ Branch <code>feat/issue-42</code> créée<br>
            ✅ Correction du media query appliquée<br>
            ✅ PR <strong>#43</strong> ouverte — <em>"Closes #42"</em><br>
            <br>
            <span class="text-muted">🚀 Le merge déclenche GitHub Actions → docker compose up -d</span>
            <div class="comment__tag">&lt;!-- hermes --&gt;</div>
          </div>
        </div>
      </div>
    </div>
    <div class="step-annotation">
      <span class="step-arrow">→</span>
      <span>Tout est automatisé : de l'issue au déploiement, sans toucher un terminal</span>
    </div>
  </div>
</div>

<style is:global>
  .workflow-chat {
    max-width: var(--max-width-content);
    margin: var(--space-8) auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* ---- Frame (scroll-reveal) ---- */
  .frame {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity var(--duration-slow) var(--ease-out),
                transform var(--duration-slow) var(--ease-out);
  }
  .frame.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .frame-label {
    font-size: var(--text-caption-1);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  /* ---- GitHub card (issue) ---- */
  .gh-card {
    background: var(--bg-secondary);
    border: 1px solid var(--separator);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
  }

  .gh-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .gh-icon { font-size: 1rem; }

  .gh-title {
    font-weight: var(--weight-semibold);
    font-size: var(--text-body);
    color: var(--label-primary);
  }

  .gh-badge {
    font-size: var(--text-caption-2);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-success);
    color: #fff;
    font-weight: var(--weight-semibold);
  }

  .gh-card-body {
    font-size: var(--text-callout);
    color: var(--label-secondary);
    line-height: var(--leading-relaxed);
  }

  .gh-card-body code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--fill-quaternary);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-xs);
  }

  /* ---- Comment thread ---- */
  .comment-thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .comment {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--separator);
  }

  .comment--user {
    background: var(--bg-secondary);
  }

  .comment--bot {
    background: var(--fill-quaternary);
  }

  .comment__avatar {
    font-size: 1.5rem;
    flex-shrink: 0;
    width: 2rem;
    text-align: center;
    line-height: 1;
  }

  .comment__body {
    flex: 1;
    min-width: 0;
  }

  .comment__meta {
    font-weight: var(--weight-semibold);
    font-size: var(--text-subheadline);
    color: var(--label-primary);
    margin-bottom: var(--space-1);
  }

  .comment__time {
    font-weight: var(--weight-regular);
    color: var(--label-tertiary);
    font-size: var(--text-footnote);
  }

  .comment__text {
    font-size: var(--text-callout);
    line-height: var(--leading-relaxed);
    color: var(--label-secondary);
  }

  .comment__text code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--fill-quaternary);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-xs);
  }

  .comment__text strong {
    color: var(--label-primary);
  }

  .text-muted {
    opacity: 0.6;
    font-size: var(--text-subheadline);
  }

  .comment__tag {
    font-size: var(--text-footnote);
    color: var(--label-tertiary);
    margin-top: var(--space-2);
    font-style: italic;
  }

  /* ---- Annotation (step explanation) ---- */
  .step-annotation {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: var(--text-subheadline);
    color: var(--label-secondary);
    line-height: var(--leading-relaxed);
  }

  .step-arrow {
    color: var(--color-accent);
    font-weight: var(--weight-bold);
    flex-shrink: 0;
  }

  .step-annotation code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--fill-quaternary);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-xs);
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .workflow-chat {
      margin: var(--space-4) 0;
      gap: var(--space-4);
    }
    .comment, .gh-card {
      padding: var(--space-3) var(--space-4);
    }
    .step-annotation {
      padding: var(--space-2) var(--space-3);
    }
  }
</style>

<script>
  (function() {
    const frames = document.querySelectorAll('.workflow-chat .frame');
    if (!frames.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.25 });

    frames.forEach(f => observer.observe(f));
  })();
</script>
