---
// FakeTerminal.astro — Terminal factice pour les tutoriels
// Props: title (string), lines (array of { cmd, output, comment? })
---

<div class="fake-terminal">
  <div class="fake-terminal__header">
    <div class="fake-terminal__dots">
      <span class="dot dot--red"></span>
      <span class="dot dot--yellow"></span>
      <span class="dot dot--green"></span>
    </div>
    <span class="fake-terminal__title">terminal</span>
  </div>
  <div class="fake-terminal__body">
    <slot />
  </div>
</div>

<style is:global>
  .fake-terminal {
    background: #0d1117;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin: var(--space-6) 0;
    box-shadow: var(--shadow-lg);
    font-family: var(--font-mono);
    font-size: var(--text-footnote);
    line-height: 1.7;
  }

  .fake-terminal__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: #161b22;
    border-bottom: 1px solid #30363d;
  }

  .fake-terminal__dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot--red { background: #ff5f57; }
  .dot--yellow { background: #febc2e; }
  .dot--green { background: #28c840; }

  .fake-terminal__title {
    color: #8b949e;
    font-size: var(--text-caption-2);
    flex: 1;
    text-align: center;
  }

  .fake-terminal__body {
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
  }

  .fake-terminal__body .line {
    margin-bottom: var(--space-1);
  }

  .fake-terminal__body .prompt {
    color: #7ee787;
    user-select: none;
  }

  .fake-terminal__body .cmd {
    color: #f0f6fc;
  }

  .fake-terminal__body .output {
    color: #8b949e;
  }

  .fake-terminal__body .comment {
    color: #484f58;
    font-style: italic;
  }

  .fake-terminal__body .success {
    color: #7ee787;
  }

  .fake-terminal__body .warning {
    color: #d29922;
  }
</style>
